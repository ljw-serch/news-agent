# 数据库（异步 MySQL）
DATABASE_URL=mysql+asyncmy://root:your_password@127.0.0.1:3306/news_app_v2?charset=utf8mb4

# Redis（可选，未启动自动降级）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# JWT
JWT_SECRET_KEY=please-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# 大模型（OpenAI 兼容协议；留空则使用本地规则引擎）
LLM_API_KEY=
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash
LLM_TIMEOUT=90

DEBUG=true
